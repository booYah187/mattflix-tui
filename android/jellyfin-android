#!/bin/bash
GAMEDIR=/$HOME/storage/downloads/jellyfin
CONFIG_FILE="$GAMEDIR/jellyfin.conf"
cd "$GAMEDIR" || exit 1

export DIALOGRC=./.dialogrc
export TERM=linux

USE_TERMUX_OPEN=0
while getopts "d" opt; do
  case $opt in
    d) USE_TERMUX_OPEN=1 ;;
  esac
done
shift $((OPTIND -1))

# Menu stack holds "function|arg" entries
declare -a MENU_STACK=()

# state variables for the main dispatcher
CURRENT_MENU="get_libraries"
CURRENT_ARG=""
MENU_ACTION=""
NEXT_MENU=""
NEXT_ARG=""

# helpers for the main loop
push_current_to_stack() {
    MENU_STACK+=("${CURRENT_MENU}|${CURRENT_ARG}")
}
pop_stack_to_current() {
    local idx=$(( ${#MENU_STACK[@]} - 1 ))
    if [ $idx -ge 0 ]; then
        local entry="${MENU_STACK[$idx]}"
        unset 'MENU_STACK[$idx]'
        CURRENT_MENU="${entry%%|*}"
        CURRENT_ARG="${entry#*|}"
        return 0
    else
        return 1
    fi
}

load_config() {
    if [ -f "$CONFIG_FILE" ]; then
        source "$CONFIG_FILE"
    else
        EMBY_URL=$(dialog --stdout --title "jellyfin" --inputbox "Enter Jellyfin Server URL (e.g., http://192.168.1.10:8096)" 8 60)
        [ -z "$EMBY_URL" ] && echo "No URL entered. Exiting." && exit 1

        EMBY_API_KEY=$(dialog --stdout --title "jellyfin" --inputbox "Enter Jellyfin API Key" 8 60)
        [ -z "$EMBY_API_KEY" ] && echo "No API key entered. Exiting." && exit 1

        mkdir -p "$(dirname "$CONFIG_FILE")"
        echo "EMBY_URL=\"$EMBY_URL\"" > "$CONFIG_FILE"
        echo "EMBY_API_KEY=\"$EMBY_API_KEY\"" >> "$CONFIG_FILE"
        source "$CONFIG_FILE"
    fi

    # normalize
    API_BASE="${EMBY_URL%/}"
    # try to fetch user id once (used for Views endpoint)
    USER_ID=$(curl -s "${API_BASE}/Users?api_key=${EMBY_API_KEY}" | jq -r '.[0].Id' 2>/dev/null || true)
}

# helper to try multiple jq filters to extract id|name pairs
extract_id_name_pairs() {
    local json="$1"
    # try several shapes
    # 1) flat array of objects: .[] | {Id, Name}
    pairs=$(echo "$json" | jq -r '.[]? | "\(.Id)|\(.Name)"' 2>/dev/null || true)
    if [ -n "$pairs" ]; then
        echo "$pairs"
        return
    fi
    # 2) Items array: .Items[] | {Id, Name}
    pairs=$(echo "$json" | jq -r '.Items[]? | "\(.Id)|\(.Name)"' 2>/dev/null || true)
    if [ -n "$pairs" ]; then
        echo "$pairs"
        return
    fi
    # 3) Views array may be nested: .Items[] inside top-level object
    pairs=$(echo "$json" | jq -r '.Items? // [] | .[]? | "\(.Id)|\(.Name)"' 2>/dev/null || true)
    if [ -n "$pairs" ]; then
        echo "$pairs"
        return
    fi
    # nothing
    return 1
}

get_libraries() {
    MENU_ACTION=""
    NEXT_MENU=""
    NEXT_ARG=""

    HIDDEN_LIBRARIES=("Games" "DoggoVision" "playlists")

    # Prefer user Views (Jellyfin), fallback to Library/MediaFolders
    if [ -n "$USER_ID" ]; then
        LIBRARIES_JSON=$(curl -s "${API_BASE}/Users/${USER_ID}/Views?api_key=${EMBY_API_KEY}")
    else
        LIBRARIES_JSON=$(curl -s "${API_BASE}/Library/MediaFolders?api_key=${EMBY_API_KEY}")
    fi

    if [ -z "$LIBRARIES_JSON" ]; then
        dialog --msgbox "Failed to fetch libraries from server." 10 50
        MENU_ACTION="exit"
        return
    fi

    LIBRARY_LIST=$(extract_id_name_pairs "$LIBRARIES_JSON")
    if [ -z "$LIBRARY_LIST" ]; then
        dialog --msgbox "No libraries found or API error." 10 50
        MENU_ACTION="exit"
        return
    fi

    declare -A SEEN_LIBS=()
    MENU_ENTRIES=()
    while IFS='|' read -r id name; do
        [ -z "$id" ] && continue
        # skip duplicates
        [ -n "${SEEN_LIBS[$id]:-}" ] && continue
        SEEN_LIBS[$id]=1

        # filter hidden by name
        skip=0
        for hidden in "${HIDDEN_LIBRARIES[@]}"; do
            [ "$name" = "$hidden" ] && { skip=1; break; }
        done
        [ $skip -eq 1 ] && continue

        SAFE_NAME=$(echo "$name" | sed 's/[^[:print:]]//g')
        MENU_ENTRIES+=("$id" "$SAFE_NAME")
    done <<< "$LIBRARY_LIST"

    MENU_ENTRIES+=("search_all" "Search All Libraries")
    MENU_ENTRIES+=("exit" "Exit")

    CHOICE=$(dialog --stdout --title "jellyfin" --no-tags --menu "Choose a library:" 20 60 14 "${MENU_ENTRIES[@]}")
    if [ -z "$CHOICE" ]; then
        MENU_ACTION="exit"
        return
    fi

    case "$CHOICE" in
        search_all)
            NEXT_MENU="search_all_libraries"
            NEXT_ARG=""
            MENU_ACTION="push"
            ;;
        exit)
            MENU_ACTION="exit"
            ;;
        *)
            NEXT_MENU="get_library_items"
            NEXT_ARG="$CHOICE"
            MENU_ACTION="push"
            ;;
    esac
}

get_library_items() {
    MENU_ACTION=""
    NEXT_MENU=""
    NEXT_ARG=""

    LIB_ID="$1"
    if [ -z "$LIB_ID" ]; then
        dialog --msgbox "No library specified." 10 50
        MENU_ACTION="pop"
        return
    fi

    # Jellyfin Items endpoint
    ITEMS_JSON=$(curl -s "${API_BASE}/Items?api_key=${EMBY_API_KEY}&ParentId=${LIB_ID}&SortBy=Name&Recursive=false")
    if [ -z "$ITEMS_JSON" ]; then
        dialog --msgbox "Failed to fetch items." 10 50
        MENU_ACTION="pop"
        return
    fi

    ITEM_LIST=$(echo "$ITEMS_JSON" | jq -r '.Items? // [] | sort_by(.IndexNumber // 0, .Name) | .[] | "\(.Id)|\(.Name)|\(.Type)"' 2>/dev/null)
    if [ -z "$ITEM_LIST" ]; then
        dialog --msgbox "No media found in this library." 10 50
        MENU_ACTION="pop"
        return
    fi

    MENU_ITEMS=()
    declare -A SEEN_ITEMS=()
    while IFS='|' read -r ID NAME TYPE; do
        [ -z "$ID" ] && continue
        [ -n "${SEEN_ITEMS[$ID]:-}" ] && continue
        SEEN_ITEMS[$ID]=1
        SAFE_NAME=$(echo "$NAME" | sed 's/[^[:print:]]//g')
        MENU_ITEMS+=("$ID" "$SAFE_NAME ($TYPE)")
    done <<< "$ITEM_LIST"

    MENU_ITEMS+=("search_all" "Search All Libraries")
    MENU_ITEMS+=("back" "Back")
    MENU_ITEMS+=("exit" "Exit")

    ITEM_CHOICE=$(dialog --stdout --title "jellyfin" --no-tags --menu "Choose media or folder:" 20 70 16 "${MENU_ITEMS[@]}")
    if [ -z "$ITEM_CHOICE" ]; then
        MENU_ACTION="pop"
        return
    fi

    case "$ITEM_CHOICE" in
        search_all)
            QUERY=$(dialog --stdout --title "jellyfin" --inputbox "Enter search term:" 8 50)
            [ -z "$QUERY" ] && { MENU_ACTION="stay"; return; }
            NEXT_MENU="search_all_libraries"
            NEXT_ARG="$QUERY"
            MENU_ACTION="push"
            ;;
        back)
            MENU_ACTION="pop"
            ;;
        exit)
            MENU_ACTION="exit"
            ;;
        *)
            SELECTED_LINE=$(echo "$ITEM_LIST" | grep "^$ITEM_CHOICE|" || true)
            SELECTED_TYPE=$(echo "$SELECTED_LINE" | cut -d'|' -f3)
            if [[ "$SELECTED_TYPE" =~ ^(Folder|Collection|BoxSet|Series|Season|GameSystem|MusicArtist|MusicAlbum)$ ]]; then
                NEXT_MENU="get_library_items"
                NEXT_ARG="$ITEM_CHOICE"
                MENU_ACTION="push"
            else
                play_media "$SELECTED_LINE"
                MENU_ACTION="stay"
            fi
            ;;
    esac
}

search_all_libraries() {
    MENU_ACTION=""
    NEXT_MENU=""
    NEXT_ARG=""

    QUERY="$1"
    if [ -z "$QUERY" ]; then
        QUERY=$(dialog --stdout --title "jellyfin" --inputbox "Enter search term:" 8 50)
        [ -z "$QUERY" ] && { MENU_ACTION="pop"; return; }
    fi

    SEARCH_RESULTS=$(curl -s "${API_BASE}/Items?api_key=${EMBY_API_KEY}&SearchTerm=$(echo "$QUERY" | jq -sRr @uri)&Recursive=true" \
        | jq -r '.Items? // [] | .[] | "\(.Id)|\(.Name)|\(.Type)"' 2>/dev/null)

    if [ -z "$SEARCH_RESULTS" ]; then
        dialog --msgbox "No results found." 8 40
        MENU_ACTION="pop"
        return
    fi

    MENU_ITEMS=()
    declare -A SEEN_SR=()
    while IFS='|' read -r ID NAME TYPE; do
        [ -z "$ID" ] && continue
        [ -n "${SEEN_SR[$ID]:-}" ] && continue
        SEEN_SR[$ID]=1
        SAFE_NAME=$(echo "$NAME" | sed 's/[^[:print:]]//g')
        MENU_ITEMS+=("$ID" "$SAFE_NAME ($TYPE)")
    done <<< "$SEARCH_RESULTS"

    MENU_ITEMS+=("back" "Back")
    MENU_ITEMS+=("exit" "Exit")

    RESULT_ID=$(dialog --stdout --title "jellyfin" --no-tags --menu "Search Results for: $QUERY" 20 70 16 "${MENU_ITEMS[@]}")
    if [ -z "$RESULT_ID" ]; then
        MENU_ACTION="pop"
        return
    fi

    case "$RESULT_ID" in
        back)
            MENU_ACTION="pop"
            ;;
        exit)
            MENU_ACTION="exit"
            ;;
        *)
            RESULT_LINE=$(echo "$SEARCH_RESULTS" | grep "^$RESULT_ID|" || true)
            RESULT_TYPE=$(echo "$RESULT_LINE" | cut -d'|' -f3)
            if [[ "$RESULT_TYPE" =~ ^(Folder|Collection|BoxSet|Series|Season)$ ]]; then
                NEXT_MENU="get_library_items"
                NEXT_ARG="$RESULT_ID"
                MENU_ACTION="push"
            else
                play_media "$RESULT_LINE"
                MENU_ACTION="stay"
            fi
            ;;
    esac
}

play_media() {
    IFS="|" read -r ITEM_ID ITEM_NAME ITEM_TYPE <<< "$1"
    SAFE_NAME=$(echo "$ITEM_NAME" | tr ' /:' '___')

    case "$ITEM_TYPE" in
        "Movie"|"Episode"|"Video")
            STREAM_URL="${API_BASE}/Videos/${ITEM_ID}/stream?Static=true&api_key=${EMBY_API_KEY}"
            if [ "$USE_TERMUX_OPEN" -eq 1 ]; then
                curl -L "$STREAM_URL" -o "${SAFE_NAME}.mp4"
            else
                if command -v am >/dev/null 2>&1; then
                    am start -n org.videolan.vlc/org.videolan.vlc.gui.video.VideoPlayerActivity -d "$STREAM_URL" || \
                    mpv "$STREAM_URL" --quiet --no-terminal
                else
                    mpv "$STREAM_URL" --quiet --no-terminal
                fi
            fi
            ;;
        "Audio")
            STREAM_URL="${API_BASE}/Audio/${ITEM_ID}/stream?Static=true&api_key=${EMBY_API_KEY}"
            if [ "$USE_TERMUX_OPEN" -eq 1 ]; then
        curl -L "$STREAM_URL" -o "${SAFE_NAME}.mp3"
                   else
                # attempt to launch via Android intent if available, otherwise mpv
                if command -v am >/dev/null 2>&1; then
                    am start -n org.videolan.vlc/org.videolan.vlc.gui.video.VideoPlayerActivity -d "$STREAM_URL" || \
                    mpv "$STREAM_URL" --quiet --no-terminal
                else
                    mpv "$STREAM_URL" --quiet --no-terminal
                fi
                fi
    ;;
        "Book")
            DOWNLOAD_URL="${API_BASE}/Items/$ITEM_ID/Download?api_key=${EMBY_API_KEY}"
            OUTPATH="$(pwd)/${SAFE_NAME}.epub"
            curl -L "$DOWNLOAD_URL" -o "$OUTPATH"
            if [ "$USE_TERMUX_OPEN" -eq 1 ]; then
                termux-open "$OUTPATH" 2>/dev/null || xdg-open "$OUTPATH" 2>/dev/null || dialog --msgbox "Saved to $OUTPATH" 8 40
            else
                if command -v am >/dev/null 2>&1; then
                    SHARED_PATH="/storage/emulated/0/Download/"
                    mkdir -p "$SHARED_PATH"
                    cp "$OUTPATH" "$SHARED_PATH/"
                    am start -a android.intent.action.VIEW -d "file://$SHARED_PATH/$(basename "$OUTPATH")" -t "application/epub+zip" || dialog --msgbox "Saved to $SHARED_PATH" 8 40
                else
                    xdg-open "$OUTPATH" 2>/dev/null || dialog --msgbox "Saved to $OUTPATH" 8 40
                fi
            fi
            ;;
        "Game")
            DOWNLOAD_URL="${API_BASE}/Items/$ITEM_ID/Download?api_key=${EMBY_API_KEY}"
            # ask extension if needed (android case)
            if [ "$USE_TERMUX_OPEN" -eq 1 ]; then
                read -p "Enter file extension for ${SAFE_NAME}: " EXT
                curl -L "$DOWNLOAD_URL" -o "${SAFE_NAME}.${EXT}"
                echo "Saved ${SAFE_NAME}.${EXT}"
            else
                TMP_PATH="$(pwd)/${SAFE_NAME}.rom"
                curl -L "$DOWNLOAD_URL" -o "$TMP_PATH"
                if command -v am >/dev/null 2>&1; then
                    am start -a android.intent.action.VIEW -d "file://$TMP_PATH" \
                      -n com.retroarch/.browser.retroactivity.RetroActivityFuture 2>/dev/null || dialog --msgbox "Saved to $TMP_PATH" 8 40
                else
                    dialog --msgbox "Saved to $TMP_PATH" 8 40
                fi
            fi
            ;;
        *)
            dialog --msgbox "Unsupported media type: $ITEM_TYPE" 8 40
            ;;
    esac
}

##########################
# Main dispatcher loop
##########################
load_config

while true; do
    MENU_ACTION=""
    NEXT_MENU=""
    NEXT_ARG=""

    # call current menu function
    if ! type "$CURRENT_MENU" >/dev/null 2>&1; then
        show_error_and_wait "Internal error: unknown menu $CURRENT_MENU"
        exit 1
    fi

    # call the menu function with arg (if any)
    if [ -n "$CURRENT_ARG" ]; then
        "$CURRENT_MENU" "$CURRENT_ARG"
    else
        "$CURRENT_MENU"
    fi

    # act on MENU_ACTION set by the menu function
    case "$MENU_ACTION" in
        push)
            # push the current context, then switch to NEXT_MENU
            MENU_STACK+=("${CURRENT_MENU}|${CURRENT_ARG}")
            CURRENT_MENU="$NEXT_MENU"
            CURRENT_ARG="$NEXT_ARG"
            ;;
        pop)
            # pop parent from stack and make it current; if none, exit
            if pop_stack_to_current; then
                # now loop will call the popped menu
                :
            else
                # nothing left -> exit
                break
            fi
            ;;
        stay)
            # don't change CURRENT_MENU/CURRENT_ARG, call it again
            :
            ;;
        exit)
            break
            ;;
        *)
            # default to exit for safety
            break
            ;;
    esac
done

clear
echo "Exited jellyfin."
