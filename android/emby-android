#!/bin/bash
GAMEDIR=/$HOME/storage/downloads/emby
CONFIG_FILE="$GAMEDIR/emby.conf"
cd "$GAMEDIR" || exit 1

export DIALOGRC=./.dialogrc
export TERM=linux

USE_TERMUX_OPEN=0
while getopts "d" opt; do
  case $opt in
    d) USE_TERMUX_OPEN=1 ;;
  esac
done
shift $((OPTIND -1))

# Menu stack holds "function|arg" entries
declare -a MENU_STACK=()

# state variables for the main dispatcher
CURRENT_MENU="get_libraries"
CURRENT_ARG=""
MENU_ACTION=""
NEXT_MENU=""
NEXT_ARG=""

# helpers for the main loop
push_current_to_stack() {
    MENU_STACK+=("${CURRENT_MENU}|${CURRENT_ARG}")
}
pop_stack_to_current() {
    local idx=$(( ${#MENU_STACK[@]} - 1 ))
    if [ $idx -ge 0 ]; then
        local entry="${MENU_STACK[$idx]}"
        unset 'MENU_STACK[$idx]'
        CURRENT_MENU="${entry%%|*}"
        CURRENT_ARG="${entry#*|}"
        return 0
    else
        return 1
    fi
}

load_config() {
    if [ -f "$CONFIG_FILE" ]; then
        source "$CONFIG_FILE"
    else
        EMBY_URL=$(dialog --stdout --title "emby" --inputbox "Enter Emby Server URL (e.g., http://192.168.1.10:8096)" 8 60)
        [ -z "$EMBY_URL" ] && echo "No URL entered. Exiting." && exit 1

        EMBY_API_KEY=$(dialog --stdout --title "emby" --inputbox "Enter Emby API Key" 8 60)
        [ -z "$EMBY_API_KEY" ] && echo "No API key entered. Exiting." && exit 1

        mkdir -p "$(dirname "$CONFIG_FILE")"
        echo "EMBY_URL=\"$EMBY_URL\"" > "$CONFIG_FILE"
        echo "EMBY_API_KEY=\"$EMBY_API_KEY\"" >> "$CONFIG_FILE"
        source "$CONFIG_FILE"
    fi
}

# show an error dialog helper
show_error_and_wait() {
    dialog --msgbox "$1" 10 50
}

get_libraries() {
    MENU_ACTION=""
    NEXT_MENU=""
    NEXT_ARG=""

    HIDDEN_LIBRARIES=("Games" "DoggoVision" "playlists")
    LIBRARIES_JSON=$(curl -s "$EMBY_URL/emby/Library/SelectableMediaFolders?api_key=$EMBY_API_KEY")
    if [ -z "$LIBRARIES_JSON" ]; then
        show_error_and_wait "Failed to fetch libraries from server."
        MENU_ACTION="exit"
        return
    fi

    # parse library list, dedupe by id
    LIBRARY_LIST=$(echo "$LIBRARIES_JSON" | jq -r '.[]? | .SubFolders[]? | "\(.Id)|\(.Name)"' 2>/dev/null)
    if [ -z "$LIBRARY_LIST" ]; then
        show_error_and_wait "No libraries found or API error."
        MENU_ACTION="exit"
        return
    fi

    declare -A SEEN_LIBS=()
    MENU_ENTRIES=()
    while IFS='|' read -r id name; do
        [ -z "$id" ] && continue
        # skip duplicates
        [ -n "${SEEN_LIBS[$id]:-}" ] && continue
        SEEN_LIBS[$id]=1

        # filter hidden by name
        skip=0
        for hidden in "${HIDDEN_LIBRARIES[@]}"; do
            [ "$name" = "$hidden" ] && { skip=1; break; }
        done
        [ $skip -eq 1 ] && continue

        SAFE_NAME=$(echo "$name" | sed 's/[^[:print:]]//g')
        MENU_ENTRIES+=("$id" "$SAFE_NAME")
    done <<< "$LIBRARY_LIST"

    # order: search (if you want it here), then exit (root has no back)
    MENU_ENTRIES+=("search_all" "Search")
    MENU_ENTRIES+=("exit" "Exit")

    CHOICE=$(dialog --stdout --title "emby" --no-tags --menu "Choose a library:" 20 60 14 "${MENU_ENTRIES[@]}")
    if [ -z "$CHOICE" ]; then
        # treat ESC as exit from root
        MENU_ACTION="exit"
        return
    fi

    case "$CHOICE" in
        search_all)
            NEXT_MENU="search_all_libraries"
            NEXT_ARG=""
            MENU_ACTION="push"   # push current (get_libraries) then go to search
            ;;
        exit)
            MENU_ACTION="exit"
            ;;
        *)
            NEXT_MENU="get_library_items"
            NEXT_ARG="$CHOICE"
            MENU_ACTION="push"
            ;;
    esac
}

get_library_items() {
    MENU_ACTION=""
    NEXT_MENU=""
    NEXT_ARG=""

    LIB_ID="$1"
    if [ -z "$LIB_ID" ]; then
        show_error_and_wait "No library specified."
        MENU_ACTION="pop"
        return
    fi

    ITEMS_JSON=$(curl -s "$EMBY_URL/emby/Items?api_key=$EMBY_API_KEY&ParentId=$LIB_ID&SortBy=Name&Recursive=false")
    if [ -z "$ITEMS_JSON" ]; then
        show_error_and_wait "Failed to fetch items."
        MENU_ACTION="pop"
        return
    fi

    # sort by IndexNumber then Name (IndexNumber may be null)
    ITEM_LIST=$(echo "$ITEMS_JSON" | jq -r '.Items? // [] | sort_by(.IndexNumber // 0, .Name) | .[] | "\(.Id)|\(.Name)|\(.Type)"' 2>/dev/null)

    if [ -z "$ITEM_LIST" ]; then
        dialog --msgbox "No media found in this library." 10 50
        MENU_ACTION="pop"
        return
    fi

    # build menu entries
    declare -A SEEN_ITEMS=()
    MENU_ITEMS=()
    while IFS='|' read -r ID NAME TYPE; do
        [ -z "$ID" ] && continue
        [ -n "${SEEN_ITEMS[$ID]:-}" ] && continue
        SEEN_ITEMS[$ID]=1
        SAFE_NAME=$(echo "$NAME" | sed 's/[^[:print:]]//g')
        MENU_ITEMS+=("$ID" "$SAFE_NAME ($TYPE)")
    done <<< "$ITEM_LIST"

    # requested order: Search, Back, Exit (back exists here)
    MENU_ITEMS+=("search_all" "Search")
    MENU_ITEMS+=("back" "Back")
    MENU_ITEMS+=("exit" "Exit")

    ITEM_CHOICE=$(dialog --stdout --title "emby" --no-tags --menu "Choose media or folder:" 20 70 16 "${MENU_ITEMS[@]}")
    if [ -z "$ITEM_CHOICE" ]; then
        # ESC -> back to previous menu
        MENU_ACTION="pop"
        return
    fi

    case "$ITEM_CHOICE" in
        search_all)
            # get query then push current and goto search
            QUERY=$(dialog --stdout --title "emby" --inputbox "Enter search term:" 8 50)
            [ -z "$QUERY" ] && { MENU_ACTION="stay"; return; }
            NEXT_MENU="search_all_libraries"
            NEXT_ARG="$QUERY"
            MENU_ACTION="push"
            ;;
        back)
            MENU_ACTION="pop"
            ;;
        exit)
            MENU_ACTION="exit"
            ;;
        *)
            SELECTED_LINE=$(echo "$ITEM_LIST" | grep "^$ITEM_CHOICE|" || true)
            SELECTED_TYPE=$(echo "$SELECTED_LINE" | cut -d'|' -f3)
            if [[ "$SELECTED_TYPE" =~ ^(Folder|Collection|BoxSet|Series|Season)$ ]]; then
                # drill down: push current (so Back will return here)
                NEXT_MENU="get_library_items"
                NEXT_ARG="$ITEM_CHOICE"
                MENU_ACTION="push"
            else
                # play media in-place; after it returns we will redisplay this menu (stay)
                play_media "$SELECTED_LINE"
                MENU_ACTION="stay"
            fi
            ;;
    esac
}

search_all_libraries() {
    MENU_ACTION=""
    NEXT_MENU=""
    NEXT_ARG=""

    # if arg passed, use it; else prompt
    QUERY="$1"
    if [ -z "$QUERY" ]; then
        QUERY=$(dialog --stdout --title "emby" --inputbox "Enter search term:" 8 50)
        [ -z "$QUERY" ] && { MENU_ACTION="pop"; return; }
    fi

    SEARCH_RESULTS=$(curl -s "$EMBY_URL/emby/Items?api_key=$EMBY_API_KEY&SearchTerm=$(echo "$QUERY" | jq -sRr @uri)&Recursive=true" \
        | jq -r '.Items? // [] | .[] | "\(.Id)|\(.Name)|\(.Type)"' 2>/dev/null)

    if [ -z "$SEARCH_RESULTS" ]; then
        dialog --msgbox "No results found." 8 40
        MENU_ACTION="pop"
        return
    fi

    declare -A SEEN_SR=()
    MENU_ITEMS=()
    while IFS='|' read -r ID NAME TYPE; do
        [ -z "$ID" ] && continue
        [ -n "${SEEN_SR[$ID]:-}" ] && continue
        SEEN_SR[$ID]=1
        SAFE_NAME=$(echo "$NAME" | sed 's/[^[:print:]]//g')
        MENU_ITEMS+=("$ID" "$SAFE_NAME ($TYPE)")
    done <<< "$SEARCH_RESULTS"

    # order: Back, Exit must be last two after search results, but user requested Search, Back, Exit. In search results 'Search' doesn't make sense,
    # so we only show Back and Exit. This matches "even if not all are present".
    MENU_ITEMS+=("back" "Back")
    MENU_ITEMS+=("exit" "Exit")

    RESULT_ID=$(dialog --stdout --title "emby" --no-tags --menu "Search Results for: $QUERY" 20 70 16 "${MENU_ITEMS[@]}")
    if [ -z "$RESULT_ID" ]; then
        MENU_ACTION="pop"
        return
    fi

    case "$RESULT_ID" in
        back)
            MENU_ACTION="pop"
            ;;
        exit)
            MENU_ACTION="exit"
            ;;
        *)
            RESULT_LINE=$(echo "$SEARCH_RESULTS" | grep "^$RESULT_ID|" || true)
            RESULT_TYPE=$(echo "$RESULT_LINE" | cut -d'|' -f3)
            if [[ "$RESULT_TYPE" =~ ^(Folder|Collection|BoxSet|Series|Season)$ ]]; then
                NEXT_MENU="get_library_items"
                NEXT_ARG="$RESULT_ID"
                MENU_ACTION="push"
            else
                play_media "$RESULT_LINE"
                MENU_ACTION="stay"
            fi
            ;;
    esac
}

play_media() {
    # arg format: "ID|Name|Type"
    IFS="|" read -r ITEM_ID ITEM_NAME ITEM_TYPE <<< "$1"
    SAFE_NAME=$(echo "$ITEM_NAME" | sed 's/[^[:alnum:]_.-]/_/g')
    case "$ITEM_TYPE" in
        "Movie"|"Episode"|"Video")
            STREAM_URL="$EMBY_URL/emby/Videos/$ITEM_ID/stream?Static=true&api_key=$EMBY_API_KEY"
            if [ "$USE_TERMUX_OPEN" -eq 1 ]; then
                # download .ts and open with termux or mpv
                TMPFILE="$(pwd)/${SAFE_NAME}.ts"
                curl -L "$STREAM_URL" -o "$TMPFILE"
                mpv "$TMPFILE" --quiet --no-terminal
                rm -f "$TMPFILE"
            else
                # attempt to launch via Android intent if available, otherwise mpv
                if command -v am >/dev/null 2>&1; then
                    am start -n org.videolan.vlc/org.videolan.vlc.gui.video.VideoPlayerActivity -d "$STREAM_URL" || \
                    mpv "$STREAM_URL" --quiet --no-terminal
                else
                    mpv "$STREAM_URL" --quiet --no-terminal
                fi
            fi
            ;;
        "Audio")
            STREAM_URL="$EMBY_URL/emby/Videos/$ITEM_ID/stream?Static=true&api_key=$EMBY_API_KEY"
            mpv "$STREAM_URL" --no-terminal --no-video --quiet
            ;;
        "Book")
            DOWNLOAD_URL="$EMBY_URL/emby/Items/$ITEM_ID/Download?api_key=$EMBY_API_KEY"
            OUTPATH="$(pwd)/${SAFE_NAME}.epub"
            curl -L "$DOWNLOAD_URL" -o "$OUTPATH"
            if [ "$USE_TERMUX_OPEN" -eq 1 ]; then
                termux-open "$OUTPATH" 2>/dev/null || xdg-open "$OUTPATH" 2>/dev/null || dialog --msgbox "Saved to $OUTPATH" 8 40
            else
                if command -v am >/dev/null 2>&1; then
                    SHARED_PATH="/storage/emulated/0/Download/emby"
                    mkdir -p "$SHARED_PATH"
                    cp "$OUTPATH" "$SHARED_PATH/"
                    am start -a android.intent.action.VIEW -d "file://$SHARED_PATH/$(basename "$OUTPATH")" -t "application/epub+zip" || dialog --msgbox "Saved to $SHARED_PATH" 8 40
                else
                    xdg-open "$OUTPATH" 2>/dev/null || dialog --msgbox "Saved to $OUTPATH" 8 40
                fi
            fi
            ;;
        "Game")
            DOWNLOAD_URL="$EMBY_URL/emby/Items/$ITEM_ID/Download?api_key=$EMBY_API_KEY"
            # ask extension if needed (android case)
            if [ "$USE_TERMUX_OPEN" -eq 1 ]; then
                read -p "Enter file extension for ${SAFE_NAME}: " EXT
                curl -L "$DOWNLOAD_URL" -o "${SAFE_NAME}.${EXT}"
                echo "Saved ${SAFE_NAME}.${EXT}"
            else
                TMP_PATH="$(pwd)/${SAFE_NAME}.rom"
                curl -L "$DOWNLOAD_URL" -o "$TMP_PATH"
                if command -v am >/dev/null 2>&1; then
                    am start -a android.intent.action.VIEW -d "file://$TMP_PATH" \
                      -n com.retroarch/.browser.retroactivity.RetroActivityFuture 2>/dev/null || dialog --msgbox "Saved to $TMP_PATH" 8 40
                else
                    dialog --msgbox "Saved to $TMP_PATH" 8 40
                fi
            fi
            ;;
        *)
            dialog --msgbox "Unsupported media type: $ITEM_TYPE" 8 40
            ;;
    esac
}

##########################
# Main dispatcher loop
##########################
load_config

while true; do
    MENU_ACTION=""
    NEXT_MENU=""
    NEXT_ARG=""

    # call current menu function
    if ! type "$CURRENT_MENU" >/dev/null 2>&1; then
        show_error_and_wait "Internal error: unknown menu $CURRENT_MENU"
        exit 1
    fi

    # call the menu function with arg (if any)
    if [ -n "$CURRENT_ARG" ]; then
        "$CURRENT_MENU" "$CURRENT_ARG"
    else
        "$CURRENT_MENU"
    fi

    # act on MENU_ACTION set by the menu function
    case "$MENU_ACTION" in
        push)
            # push the current context, then switch to NEXT_MENU
            MENU_STACK+=("${CURRENT_MENU}|${CURRENT_ARG}")
            CURRENT_MENU="$NEXT_MENU"
            CURRENT_ARG="$NEXT_ARG"
            ;;
        pop)
            # pop parent from stack and make it current; if none, exit
            if pop_stack_to_current; then
                # now loop will call the popped menu
                :
            else
                # nothing left -> exit
                break
            fi
            ;;
        stay)
            # don't change CURRENT_MENU/CURRENT_ARG, call it again
            :
            ;;
        exit)
            break
            ;;
        *)
            # default to exit for safety
            break
            ;;
    esac
done

clear
echo "Exited emby."
