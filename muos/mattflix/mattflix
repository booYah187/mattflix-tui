#!/bin/bash
GAMEDIR=/$directory/ports/mattflix
CONFIG_FILE="$GAMEDIR/mattflix.conf"
cd "$GAMEDIR" || exit 1

export DIALOGRC=./.dialogrc
export LD_LIBRARY_PATH="/usr/lib:$GAMEDIR/libs:$LD_LIBRARY_PATH"
export TERM=linux

declare -a MENU_STACK=()

push_current_to_stack() {
    MENU_STACK+=("${CURRENT_MENU}|${CURRENT_ARG}")
}

pop_stack_to_current() {
    local idx=$(( ${#MENU_STACK[@]} - 1 ))
    if [ $idx -ge 0 ]; then
        local entry="${MENU_STACK[$idx]}"
        unset 'MENU_STACK[$idx]'
        CURRENT_MENU="${entry%%|*}"
        CURRENT_ARG="${entry#*|}"
        return 0
    else
        return 1
    fi
}

load_config() {
    if [ -f "$CONFIG_FILE" ]; then
        source "$CONFIG_FILE"
    else
        EMBY_URL=$(dialog --stdout --inputbox "Enter Emby Server URL (e.g., http://192.168.1.10:8096)" 8 60)
        [ -z "$EMBY_URL" ] && echo "No URL entered. Exiting." && exit 1

        EMBY_API_KEY=$(dialog --stdout --inputbox "Enter Emby API Key" 8 60)
        [ -z "$EMBY_API_KEY" ] && echo "No API key entered. Exiting." && exit 1

        mkdir -p "$(dirname "$CONFIG_FILE")"
        echo "EMBY_URL=\"$EMBY_URL\"" > "$CONFIG_FILE"
        echo "EMBY_API_KEY=\"$EMBY_API_KEY\"" >> "$CONFIG_FILE"
        source "$CONFIG_FILE"
    fi
}

get_libraries() {
    MENU_ACTION=""
    NEXT_MENU=""
    NEXT_ARG=""

    HIDDEN_LIBRARIES=("Games" "DoggoVision" "playlists")
    LIBRARIES_JSON=$(curl -s "$EMBY_URL/emby/Library/SelectableMediaFolders?api_key=$EMBY_API_KEY")
    if [ -z "$LIBRARIES_JSON" ]; then
        dialog --msgbox "Failed to fetch libraries from server." 10 50
        MENU_ACTION="exit"
        return
    fi

    LIBRARY_LIST=$(echo "$LIBRARIES_JSON" | jq -r '.[]? | .SubFolders[]? | "\(.Id)|\(.Name)"' 2>/dev/null)
    if [ -z "$LIBRARY_LIST" ]; then
        dialog --msgbox "No libraries found or API error." 10 50
        MENU_ACTION="exit"
        return
    fi

    declare -A SEEN_LIBS=()
    MENU_ENTRIES=()
    while IFS='|' read -r id name; do
        [ -z "$id" ] && continue
        [ -n "${SEEN_LIBS[$id]:-}" ] && continue
        SEEN_LIBS[$id]=1

        skip=0
        for hidden in "${HIDDEN_LIBRARIES[@]}"; do
            [ "$name" = "$hidden" ] && { skip=1; break; }
        done
        [ $skip -eq 1 ] && continue

        SAFE_NAME=$(echo "$name" | sed 's/[^[:print:]]//g')
        MENU_ENTRIES+=("$id" "$SAFE_NAME")
    done <<< "$LIBRARY_LIST"

    MENU_ENTRIES+=("search_all" "Search")
    MENU_ENTRIES+=("exit" "Exit")

    CHOICE=$(dialog --stdout --title "mattflix" --no-tags --menu "Choose a library:" 20 60 14 "${MENU_ENTRIES[@]}")
    if [ -z "$CHOICE" ]; then
        MENU_ACTION="exit"
        return
    fi

    case "$CHOICE" in
        search_all)
            NEXT_MENU="search_all_libraries"
            NEXT_ARG=""
            MENU_ACTION="push"
            ;;
        exit)
            MENU_ACTION="exit"
            ;;
        *)
            NEXT_MENU="get_library_items"
            NEXT_ARG="$CHOICE"
            MENU_ACTION="push"
            ;;
    esac
}

get_library_items() {
    MENU_ACTION=""
    NEXT_MENU=""
    NEXT_ARG=""

    LIB_ID="$1"
    if [ -z "$LIB_ID" ]; then
        dialog --msgbox "No library specified." 10 50
        MENU_ACTION="pop"
        return
    fi

    ITEMS_JSON=$(curl -s "$EMBY_URL/emby/Items?api_key=$EMBY_API_KEY&ParentId=$LIB_ID&SortBy=Name&Recursive=false")
    if [ -z "$ITEMS_JSON" ]; then
        dialog --msgbox "Failed to fetch items." 10 50
        MENU_ACTION="pop"
        return
    fi

    ITEM_LIST=$(echo "$ITEMS_JSON" | jq -r '.Items? // [] | sort_by(.IndexNumber // 0, .Name) | .[] | "\(.Id)|\(.Name)|\(.Type)"' 2>/dev/null)
    if [ -z "$ITEM_LIST" ]; then
        dialog --msgbox "No media found in this library." 10 50
        MENU_ACTION="pop"
        return
    fi

    MENU_ITEMS=()
    while IFS='|' read -r ID NAME TYPE; do
        [ -z "$ID" ] && continue
        SAFE_NAME=$(echo "$NAME" | sed 's/[^[:print:]]//g')
        MENU_ITEMS+=("$ID" "$SAFE_NAME ($TYPE)")
    done <<< "$ITEM_LIST"

    MENU_ITEMS+=("search_all" "Search")
    MENU_ITEMS+=("back" "Back")
    MENU_ITEMS+=("exit" "Exit")

    ITEM_CHOICE=$(dialog --stdout --title "mattflix" --no-tags --menu "Choose media or folder:" 20 70 16 "${MENU_ITEMS[@]}")
    if [ -z "$ITEM_CHOICE" ]; then
        MENU_ACTION="pop"
        return
    fi

    case "$ITEM_CHOICE" in
        search_all)
            QUERY=$(dialog --stdout --title "mattflix" --inputbox "Enter search term:" 8 50)
            [ -z "$QUERY" ] && { MENU_ACTION="stay"; return; }
            NEXT_MENU="search_all_libraries"
            NEXT_ARG="$QUERY"
            MENU_ACTION="push"
            ;;
        back)
            MENU_ACTION="pop"
            ;;
        exit)
            MENU_ACTION="exit"
            ;;
        *)
            SELECTED_LINE=$(echo "$ITEM_LIST" | grep "^$ITEM_CHOICE|" || true)
            SELECTED_TYPE=$(echo "$SELECTED_LINE" | cut -d'|' -f3)
            if [[ "$SELECTED_TYPE" =~ ^(Folder|Collection|BoxSet|Series|Season)$ ]]; then
                NEXT_MENU="get_library_items"
                NEXT_ARG="$ITEM_CHOICE"
                MENU_ACTION="push"
            else
                play_media "$SELECTED_LINE"
                MENU_ACTION="stay"
            fi
            ;;
    esac
}

search_all_libraries() {
    MENU_ACTION=""
    NEXT_MENU=""
    NEXT_ARG=""

    QUERY="$1"
    if [ -z "$QUERY" ]; then
        QUERY=$(dialog --stdout --title "mattflix" --inputbox "Enter search term:" 8 50)
        [ -z "$QUERY" ] && { MENU_ACTION="pop"; return; }
    fi

    SEARCH_RESULTS=$(curl -s "$EMBY_URL/emby/Items?api_key=$EMBY_API_KEY&SearchTerm=$(echo "$QUERY" | jq -sRr @uri)&Recursive=true" \
        | jq -r '.Items? // [] | .[] | "\(.Id)|\(.Name)|\(.Type)"' 2>/dev/null)

    if [ -z "$SEARCH_RESULTS" ]; then
        dialog --msgbox "No results found." 8 40
        MENU_ACTION="pop"
        return
    fi

    MENU_ITEMS=()
    while IFS='|' read -r ID NAME TYPE; do
        [ -z "$ID" ] && continue
        SAFE_NAME=$(echo "$NAME" | sed 's/[^[:print:]]//g')
        MENU_ITEMS+=("$ID" "$SAFE_NAME ($TYPE)")
    done <<< "$SEARCH_RESULTS"

    MENU_ITEMS+=("back" "Back")
    MENU_ITEMS+=("exit" "Exit")

    RESULT_ID=$(dialog --stdout --title "mattflix" --no-tags --menu "Search Results for: $QUERY" 20 70 16 "${MENU_ITEMS[@]}")
    if [ -z "$RESULT_ID" ]; then
        MENU_ACTION="pop"
        return
    fi

    case "$RESULT_ID" in
        back)
            MENU_ACTION="pop"
            ;;
        exit)
            MENU_ACTION="exit"
            ;;
        *)
            RESULT_LINE=$(echo "$SEARCH_RESULTS" | grep "^$RESULT_ID|" || true)
            RESULT_TYPE=$(echo "$RESULT_LINE" | cut -d'|' -f3)
            if [[ "$RESULT_TYPE" =~ ^(Folder|Collection|BoxSet|Series|Season)$ ]]; then
                NEXT_MENU="get_library_items"
                NEXT_ARG="$RESULT_ID"
                MENU_ACTION="push"
            else
                play_media "$RESULT_LINE"
                MENU_ACTION="stay"
            fi
            ;;
    esac
}

play_media() {
    IFS="|" read -r ITEM_ID ITEM_NAME ITEM_TYPE <<< "$1"
    SAFE_NAME=$(echo "$ITEM_NAME" | tr ' /:' '___')

    case "$ITEM_TYPE" in
        "Movie"|"Episode"|"Video"|"Audio")
            STREAM_URL="$EMBY_URL/emby/Videos/$ITEM_ID/stream?Static=true&api_key=$EMBY_API_KEY"
            echo "Playing: $STREAM_URL"
            mpv "$STREAM_URL" --quiet --no-terminal > /dev/null 2>&1             
            ;;
        "Book")
            DOWNLOAD_URL="$EMBY_URL/emby/Items/$ITEM_ID/Download?api_key=$EMBY_API_KEY"
            curl -L "$DOWNLOAD_URL" -o "/mnt/sdcard/ROMS/BOOKS/Downloads/${SAFE_NAME}.epub"
            echo "/mnt/sdcard/ROMS/BOOKS/Downloads/${SAFE_NAME}.epub" > /tmp/mreader.rom
	    clear
	    exit 0
            ;;
        *)
            dialog --msgbox "Unsupported media type: $ITEM_TYPE" 10 40
            ;;
    esac
}

# Main loop
load_config
CURRENT_MENU="get_libraries"
CURRENT_ARG=""

while true; do
    MENU_ACTION=""
    NEXT_MENU=""
    NEXT_ARG=""

    if ! type "$CURRENT_MENU" >/dev/null 2>&1; then
        dialog --msgbox "Internal error: unknown menu $CURRENT_MENU" 10 40
        break
    fi

    if [ -n "$CURRENT_ARG" ]; then
        "$CURRENT_MENU" "$CURRENT_ARG"
    else
        "$CURRENT_MENU"
    fi

    case "$MENU_ACTION" in
        push)
            push_current_to_stack
            CURRENT_MENU="$NEXT_MENU"
            CURRENT_ARG="$NEXT_ARG"
            ;;
        pop)
            if pop_stack_to_current; then
                :
            else
                break
            fi
            ;;
        stay)
            ;;
        exit)
            break
            ;;
        *)
            break
            ;;
    esac
done

clear
echo "Exited."
